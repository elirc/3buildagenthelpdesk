# Port 5462 matches the host port mapping in docker-compose.yml. If you
# point this at your own Postgres instead of the bundled container, change
# the port to match yours.
DATABASE_URL="postgresql://postgres:postgres@localhost:5462/agentdesk?schema=public"
NEXT_PUBLIC_APP_NAME="Agentic Help Desk"
AUTH_PROVIDER="local-demo"
ALLOW_DEMO_AUTH="true"
