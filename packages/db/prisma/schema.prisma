generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPPORT_AGENT
  ENGINEERING
  MANAGER
  VIEWER
}

enum TicketStatus {
  NEW
  TRIAGE
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketCategory {
  ACCESS
  BILLING
  BUG
  PERFORMANCE
  INTEGRATION
  SECURITY
  OTHER
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum IncidentSeverity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum LogEnvironment {
  development
  staging
  production
}

enum LogLevel {
  debug
  info
  warn
  error
  fatal
}

enum JobType {
  EMAIL_NOTIFICATION
  WEBHOOK_DELIVERY
  SLA_ESCALATION
  REPORT_GENERATION
  DATA_SYNC
  AGENT_RUN
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  DEAD_LETTERED
}

enum AgentType {
  TICKET_SUMMARIZATION
  LOG_ANOMALY_DETECTION
  FAILED_JOB_INVESTIGATION
  DUPLICATE_DETECTION
}

enum AgentRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AgentTargetType {
  TICKET
  INCIDENT
  LOG_GROUP
  JOB
}

model Organization {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  users       User[]
  teams       Team[]
  tickets     Ticket[]
  incidents   Incident[]
  logs        StructuredLog[]
  jobs        BackgroundJob[]
  agentRuns   AgentRun[]
  auditEvents AuditEvent[]
  cannedReplies CannedReply[]
  ticketLinks TicketLink[]
  savedViews  SavedView[]
  businessCalendar BusinessCalendar?
  routingRules RoutingRule[]
  apiKeys     ApiKey[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model User {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  name            String
  email           String          @unique
  role            UserRole
  teamId          String?
  team            Team?           @relation(fields: [teamId], references: [id])
  assignedTickets Ticket[]        @relation("AssignedTickets")
  comments        TicketComment[]
  ownedIncidents  Incident[]      @relation("IncidentOwner")
  auditEvents     AuditEvent[]
  agentRuns       AgentRun[]
  cannedReplies   CannedReply[]   @relation("CannedReplies")
  ticketLinks     TicketLink[]    @relation("TicketLinks")
  savedViews      SavedView[]     @relation("SavedViews")
  routedRules     RoutingRule[]   @relation("RoutedUser")
  apiKeys         ApiKey[]        @relation("ApiKeys")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, role])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  slug           String
  users          User[]
  tickets        Ticket[]
  routedRules    RoutingRule[] @relation("RoutedTeam")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model Ticket {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  title          String
  description    String
  customerName   String
  requesterEmail String
  status         TicketStatus    @default(NEW)
  priority       TicketPriority
  category       TicketCategory
  assignedTeamId String?
  assignedTeam   Team?           @relation(fields: [assignedTeamId], references: [id])
  assignedUserId String?
  assignedUser   User?           @relation("AssignedTickets", fields: [assignedUserId], references: [id])
  slaDueAt       DateTime
  // The SLA clock stops while a ticket waits on the customer. Rather than
  // rewriting slaDueAt on every pause — which would destroy the original
  // commitment and make "how long did we actually take" unanswerable — the
  // paused time is accumulated alongside it and added back when the
  // effective deadline is computed.
  //
  // slaPausedAt is the start of the pause currently in progress, or null.
  // slaPausedTotalMs is the sum of every pause that has already ended.
  slaPausedAt      DateTime?
  slaPausedTotalMs Int       @default(0)
  // Resolution SLA is the lagging metric; this is the leading one. Both are
  // nullable so existing rows read as "not tracked" rather than "breached".
  firstResponseDueAt DateTime?
  firstRespondedAt   DateTime?
  resolvedAt     DateTime?
  incidentId     String?
  incident       Incident?       @relation(fields: [incidentId], references: [id])
  tags           String[]        @default([])
  comments       TicketComment[]
  logs           StructuredLog[]
  jobs           BackgroundJob[]
  linksOut       TicketLink[]    @relation("LinkSource")
  linksIn        TicketLink[]    @relation("LinkTarget")
  // A merged ticket is closed and points at its survivor. It is never
  // deleted: it is the record of what a customer actually reported.
  mergedIntoId   String?
  mergedInto     Ticket?         @relation("TicketMerges", fields: [mergedIntoId], references: [id])
  mergedFrom     Ticket[]        @relation("TicketMerges")
  mergedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organizationId, status, priority])
  @@index([organizationId, incidentId])
  @@index([organizationId, assignedUserId])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(true)
  // Which template this reply started from, if any. Nullable and never
  // cascading: the comment is the record of what was actually said, and it
  // must survive the template being edited or retired afterwards.
  cannedReplyId String?
  cannedReply   CannedReply? @relation(fields: [cannedReplyId], references: [id])
  createdAt  DateTime @default(now())
}

/// One row per worker process, upserted on every poll.
///
/// Without this there is no way to answer "is anything draining the queue".
/// A queue with no worker looks exactly like a queue with no work: jobs sit
/// in QUEUED and nothing complains.
model WorkerHeartbeat {
  id             String   @id @default(cuid())
  workerId       String   @unique
  lastSeenAt     DateTime @updatedAt
  processedCount Int      @default(0)
  failedCount    Int      @default(0)
  startedAt      DateTime @default(now())
}

/// A named filter+sort combination, saved per user and optionally shared.
///
/// queryString holds a sanitised URLSearchParams, never the raw query the
/// user was on. See sanitizeViewQuery: replaying arbitrary stored query
/// strings is how a saved view turns into a redirect primitive.
model SavedView {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  ownerId        String
  owner          User         @relation("SavedViews", fields: [ownerId], references: [id])
  name           String
  resource       String
  queryString    String
  isShared       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([ownerId, resource, name])
  @@index([organizationId, resource])
}

/// Working hours for an organization, used to decide when the SLA clock
/// is allowed to run. One row per organization, hence the @unique.
model BusinessCalendar {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  timezone           String       @default("UTC")
  // Minutes past midnight. 540 = 09:00, 1020 = 17:00.
  workdayStartMinute Int          @default(540)
  workdayEndMinute   Int          @default(1020)
  // 0 = Sunday, matching JavaScript's getUTCDay().
  workdays           Int[]        @default([1, 2, 3, 4, 5])
  holidays           DateTime[]   @default([])
  updatedAt          DateTime     @updatedAt
}

/// A hashed API credential.
///
/// keyHash is a SHA-256 of the full key; the key itself is never stored,
/// so a database dump does not hand over working credentials. keyPrefix is
/// the first characters, kept in the clear purely so a human can tell two
/// keys apart in the UI.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  keyPrefix      String       @unique
  keyHash        String
  scopes         String[]     @default(["read:tickets"])
  createdById    String?
  createdBy      User?        @relation("ApiKeys", fields: [createdById], references: [id])
  lastUsedAt     DateTime?
  requestCount   Int          @default(0)
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, revokedAt])
}

enum RoutingConditionField {
  CATEGORY
  PRIORITY
  TAG
  TITLE_CONTAINS
  DESCRIPTION_CONTAINS
  REQUESTER_EMAIL_DOMAIN
}

/// An ordered rule that assigns new tickets automatically.
///
/// conditions is Json because the shape is a list of {field, operator,
/// value} and normalising it into a table would buy nothing: rules are
/// read as a whole, never queried by individual condition.
model RoutingRule {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  priorityOrder  Int             @default(100)
  isActive       Boolean         @default(true)
  conditions     Json            @default("[]")
  assignTeamId   String?
  assignTeam     Team?           @relation("RoutedTeam", fields: [assignTeamId], references: [id])
  assignUserId   String?
  assignUser     User?           @relation("RoutedUser", fields: [assignUserId], references: [id])
  setPriority    TicketPriority?
  addTags        String[]        @default([])
  matchCount     Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, isActive, priorityOrder])
}

enum TicketLinkType {
  DUPLICATE_OF
  RELATED_TO
  BLOCKS
  CAUSED_BY
}

/// A directed relationship between two tickets in the same organization.
///
/// Stored once, read from both ends: the ticket page shows outgoing links
/// with their own wording and incoming links with the inverse wording. Two
/// rows per relationship would double the write path and let the two halves
/// drift out of sync.
model TicketLink {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  sourceTicketId String
  sourceTicket   Ticket         @relation("LinkSource", fields: [sourceTicketId], references: [id], onDelete: Cascade)
  targetTicketId String
  targetTicket   Ticket         @relation("LinkTarget", fields: [targetTicketId], references: [id], onDelete: Cascade)
  linkType       TicketLinkType
  note           String?
  createdById    String?
  createdBy      User?          @relation("TicketLinks", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())

  // Guards the exact duplicate. The reverse-direction and self-link rules
  // are not expressible as constraints and live in validateTicketLink.
  @@unique([sourceTicketId, targetTicketId, linkType])
  @@index([organizationId, targetTicketId])
}

model CannedReply {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  title          String
  body           String
  // Null means the template is offered on every ticket. A category scopes
  // it to tickets of that kind.
  category       TicketCategory?
  // Retired templates are deactivated rather than deleted, so historical
  // comments keep pointing at something real.
  isActive       Boolean         @default(true)
  createdById    String?
  createdBy      User?           @relation("CannedReplies", fields: [createdById], references: [id])
  usageCount     Int             @default(0)
  comments       TicketComment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, title])
  @@index([organizationId, category, isActive])
}

model Incident {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  title           String
  description     String
  status          IncidentStatus   @default(INVESTIGATING)
  severity        IncidentSeverity
  affectedService String
  startedAt       DateTime         @default(now())
  resolvedAt      DateTime?
  ownerId         String?
  owner           User?            @relation("IncidentOwner", fields: [ownerId], references: [id])
  tickets         Ticket[]
  logs            StructuredLog[]
  jobs            BackgroundJob[]
  agentFindings   Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, status, severity])
  @@index([organizationId, affectedService])
}

model StructuredLog {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  timestamp        DateTime       @default(now())
  service          String
  environment      LogEnvironment
  level            LogLevel
  message          String
  requestId        String
  userId           String?
  ticketId         String?
  ticket           Ticket?        @relation(fields: [ticketId], references: [id])
  incidentId       String?
  incident         Incident?      @relation(fields: [incidentId], references: [id])
  metadata         Json           @default("{}")
  fingerprint      String
  requestContextId String?

  @@index([organizationId, service, environment, level])
  @@index([organizationId, fingerprint])
  @@index([organizationId, ticketId])
  @@index([organizationId, incidentId])
  @@index([organizationId, timestamp])
}

model BackgroundJob {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  type              JobType
  status            JobStatus
  attempts          Int          @default(0)
  maxAttempts       Int          @default(3)
  payload           Json         @default("{}")
  errorMessage      String?
  requestContextId  String?
  lockedAt          DateTime?
  lockedBy          String?
  // When this job becomes eligible to run. Defaults to now, so every
  // existing row is immediately due and nothing changes for them.
  runAt             DateTime     @default(now())
  lastAttemptAt     DateTime?
  deadLetteredAt    DateTime?
  // Why an operator sent this back, recorded on the job rather than only
  // in the audit log so it is visible where the decision matters.
  requeueReason     String?
  requeueCount      Int          @default(0)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime     @default(now())
  relatedTicketId   String?
  relatedTicket     Ticket?      @relation(fields: [relatedTicketId], references: [id])
  relatedIncidentId String?
  relatedIncident   Incident?    @relation(fields: [relatedIncidentId], references: [id])

  @@index([organizationId, status, type])
  @@index([organizationId, relatedTicketId])
  @@index([organizationId, relatedIncidentId])
  @@index([organizationId, createdAt])
  @@index([status, lockedAt])
  @@index([status, runAt])
}

model AgentRun {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  agentType        AgentType
  status           AgentRunStatus  @default(PENDING)
  targetType       AgentTargetType
  targetId         String
  inputSnapshot    Json
  output           Json?
  confidenceScore  Float?
  startedAt        DateTime?
  completedAt      DateTime?
  errorMessage     String?
  requestContextId String?
  agentVersion     String          @default("1")
  createdByUserId  String?
  createdBy        User?           @relation(fields: [createdByUserId], references: [id])
  trace            Json?
  // A replay is an AgentRun too, so it inherits the whole detail page.
  // Self-relation: replayOf points at the run whose inputSnapshot was
  // re-used, which is what makes before/after comparable at all.
  replayOfRunId    String?
  replayOf         AgentRun?       @relation("AgentReplays", fields: [replayOfRunId], references: [id])
  replays          AgentRun[]      @relation("AgentReplays")
  isReplay         Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@index([organizationId, agentType, status])
  @@index([organizationId, targetType, targetId])
  @@index([organizationId, createdAt])
  @@index([organizationId, isReplay, createdAt])
}

model AuditEvent {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  actorUserId      String?
  actor            User?        @relation(fields: [actorUserId], references: [id])
  action           String
  entityType       String
  entityId         String
  before           Json?
  after            Json?
  metadata         Json         @default("{}")
  requestContextId String?
  createdAt        DateTime     @default(now())

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action])
  @@index([organizationId, createdAt])
  @@index([requestContextId])
}
